#!/usr/bin/env bash

PROJECT_DIR="$(git rev-parse --show-toplevel)"

cd "$PROJECT_DIR"

files=$(git diff --cached --name-only --diff-filter=ACMR | sed 's| |\\ |g')

[ -z "$files" ] && exit 0

# Prettify all selected files
BIOME="$PROJECT_DIR/web/node_modules/.bin/biome"
if [ -f "$BIOME" ]; then
    "$BIOME" lint --write --staged --diagnostic-level=error --no-errors-on-unmatched --log-kind=compact
fi

echo "$files" | grep ".rs$" | xargs rustfmt --edition 2024 

# Add back the modified/prettified files to staging
echo "$files" | xargs git add

