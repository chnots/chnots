{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile-capability",
  "windows": ["main"],
  "platforms": ["android"],
  "permissions": [
    "core:default",
    "fs:default",
    "http:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://*:*"
        },
        {
          "url": "file://*:*"
        },
        {
          "url": "http://*:*"
        },
        {
          "url": "asset://localhost/**"
        },
        {
          "url": "https://api.github.com/**"
        }
      ]
    }
  ]
}
