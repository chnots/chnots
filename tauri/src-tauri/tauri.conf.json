{
  "productName": "Chnots",
  "version": "0.0.113",
  "identifier": "org.codeberg.wangzh.chnots",
  "build": {
    "frontendDist": "../../web-dist"
  },
  "app": {
    "windows": [
      {
        "title": "Chnots",
