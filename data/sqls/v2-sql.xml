insert into
k_file_meta (
otid,
inline,
archor,
content_type,
filename,
filesize,
id,
last_modified,
sid,
tid,
binaryp
)
select distinct
case
when (cm.meta_otid is not null) then cm.meta_otid
else fm.tid
end as otid,
fm.inline,
fm.archor,
fm.content_type,
fm.filename,
fm.filesize,
fm.id,
fm.last_modified,
fm.sid,
fm.tid,
<match>
  <sqlite> 1 </sqlite>
  <postgres> true </postgres>
</match>
from
k_file_meta_bak fm
left join chnot_kind_rel_bak cm on fm.id = cm.kind_id;

