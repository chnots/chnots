insert into
chnot_meta (otid, kspace, kind, tid, archive_tid)
select
otid,
kspace,
kind,
tid,
<match>
  <sqlite> unixepoch </sqlite>
  <postgres> date_part </postgres>
</match> ('epoch', archive_time) * 1000000
from
chnot_metadata_bak cm
where
cm.kind = 'mdwt';

insert into
chnot_meta (otid, kspace, kind, tid, archive_tid)
select
cast(ckr.kind_id as bigint) as otid,
kspace,
kind,
cm.tid,
<match>
  <sqlite> unixepoch </sqlite>
  <postgres> date_part </postgres>
</match> ('epoch', archive_time) * 1000000
from
chnot_metadata_bak cm
left join chnot_kind_rel_bak ckr on cm.otid = ckr.meta_otid
where
(
cm.kind = 'ktabv1'
or cm.kind = 'llm_chat'
)
and ckr.kind_id is not null;

insert into
chnot_meta (otid, kspace, kind, tid, archive_tid)
select
otid,
kspace,
kind,
tid,
<match>
  <sqlite> unixepoch </sqlite>
  <postgres> date_part </postgres>
</match> ('epoch', archive_time) * 1000000
from
chnot_metadata_bak cm
where
cm.kind = 'resov1'
or cm.kind = 'exdrv1';

