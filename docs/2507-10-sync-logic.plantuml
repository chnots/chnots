@startuml
participant Instance1 as i1
participant Instance2 as i2

i1 -> i1: getNodeList
i1 -> i2: SyncShake {client_id, version, server_id}
i2 -> i2: check version
alt version is not matched
    i2 -> i1: stop syncing
    i1 ->: fail
else
    i2 -> i1: send last sync time
end

i1 -> i1: check last sync time is the same value
alt same time
    i1 -> i2: send getSameKeys [many times]
    i1 -> i1: save to temporary table. \n[sync_sk_{table_name}_{id}]
else
    i1->: fail
end

i1 -> i1: calc more, less and\n the same items.

i1 -> i2: SyncFetchAbsent
i2 -> i1: send records

i1 -> i1: remove from temporary table


@enduml